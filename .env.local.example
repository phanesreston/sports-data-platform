# ── Database ──────────────────────────────────────────────────────────────────
# Local dev — SQLite file on disk (no setup needed):
DATABASE_URL=file:./sports.db

# Production — Turso cloud (swap these in when deploying):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Protects the /api/admin/sync endpoint — set any long random string
ADMIN_SECRET=change-me

# ── The Odds API ───────────────────────────────────────────────────────────────
# The Odds API - https://the-odds-api.com/
# Get a free key at https://the-odds-api.com/#get-access
ODDS_API_KEY=your_api_key_here

# Regions to fetch odds for. Each region costs 1 credit per API call.
# Options: uk, eu, us, us2, au  (comma-separate for multiple e.g. "uk,eu")
# Default: uk (1 credit per call — recommended for free tier)
ODDS_API_REGIONS=uk

# API-Sports - https://api-sports.io/
# Covers 40+ sports: football, basketball, tennis, baseball, hockey & more
# Get a key at https://dashboard.api-sports.io/register
API_SPORTS_KEY=your_api_key_here

# The Racing API - https://theracingapi.com/
# UK/Ireland + international horse racing: racecards, results, form, jockey/trainer stats
# Get a key at https://theracingapi.com/
RACING_API_KEY=your_api_key_here
